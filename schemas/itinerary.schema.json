{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smarttrip.example/schemas/itinerary.schema.json",
  "title": "SmartTrip Itinerary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tripId", "revision", "mode", "destination", "timeZone", "startDate", "endDate", "travelers", "currency", "budgetMinor", "budgetIncludes", "assumptions", "warnings", "days", "costSummary", "sources", "generatedAt"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "tripId": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "mode": { "enum": ["demo", "live", "fallback"] },
    "destination": { "type": "string", "minLength": 1 },
    "timeZone": { "type": "string", "minLength": 1 },
    "startDate": { "type": "string", "format": "date" },
    "endDate": { "type": "string", "format": "date" },
    "travelers": { "type": "integer", "minimum": 1, "maximum": 12 },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "budgetMinor": { "type": "integer", "minimum": 1 },
    "budgetIncludes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "days": { "type": "array", "minItems": 1, "maxItems": 14, "items": { "$ref": "#/$defs/day" } },
    "costSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["knownTotalMinor", "unknownCostCount", "budgetStatus", "exclusions"],
      "properties": {
        "knownTotalMinor": { "type": "integer", "minimum": 0 },
        "unknownCostCount": { "type": "integer", "minimum": 0 },
        "budgetStatus": { "enum": ["within", "over", "uncertain"] },
        "exclusions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "generatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "cost": {
      "type": "object", "additionalProperties": false,
      "required": ["amountMinor", "status"],
      "properties": {
        "amountMinor": { "type": ["integer", "null"], "minimum": 0 },
        "status": { "enum": ["estimate", "provider_quote", "free", "unknown"] }
      }
    },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "title", "startTime", "endTime", "location", "notes", "cost", "sourceIds", "verification"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["activity", "meal", "transport", "rest", "lodging", "other"] },
        "title": { "type": "string", "minLength": 1 },
        "startTime": { "type": ["string", "null"], "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "endTime": { "type": ["string", "null"], "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "location": { "type": ["string", "null"] },
        "notes": { "type": "string" },
        "cost": { "$ref": "#/$defs/cost" },
        "sourceIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "verification": { "enum": ["sample", "unverified", "source_supported"] }
      }
    },
    "day": {
      "type": "object", "additionalProperties": false,
      "required": ["date", "title", "items", "knownTotalMinor"],
      "properties": {
        "date": { "type": "string", "format": "date" },
        "title": { "type": "string" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
        "knownTotalMinor": { "type": "integer", "minimum": 0 }
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "provider", "url", "retrievedAt", "dataStatus"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "provider": { "type": "string" },
        "url": { "type": ["string", "null"], "format": "uri" },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "dataStatus": { "enum": ["live", "cached", "sample"] }
      }
    }
  }
}
